# Copia para .env (na raiz).
#
# Na máquina host (yarn migrate:up / yarn start:dev / testes):
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/billing
#
# Compose: host `postgres`. Kubernetes: host `billing-postgres`.
# postgresql://postgres:postgres@billing-postgres:5432/billing

# INTEGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/billing

JWT_SECRET=altere-este-segredo
JWT_EXPIRES_IN=1d
PORT=3000

SERVICE_NAME=billing-service
NEW_RELIC_APP_NAME=billing-service
NEW_RELIC_LABELS=service:billing-service;component:billing
# NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false

# Stock (cotação FIFO síncrona ao gerar orçamento)
STOCK_SERVICE_URL=http://localhost:3002

# Mercado Pago (sandbox). Sem token, o gateway usa stub local.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# MP_NOTIFICATION_URL=https://seu-host/webhooks/mercado-pago
# MP_SUCCESS_URL=https://seu-front/pagamento/sucesso
# MP_FAILURE_URL=https://seu-front/pagamento/falha
# MP_PENDING_URL=https://seu-front/pagamento/pendente

# SNS/SQS (saga coreografada). Sem tópico/fila, publisher e consumer ficam noop.
# AWS_REGION=us-east-1
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-domain-events
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/billing-events
# AWS_ENDPOINT_URL=http://localhost:4566
